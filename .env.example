# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-study-assistant

# JWT (Sử dụng chuỗi ngẫu nhiên đủ dài >= 64 ký tự)
JWT_SECRET=your_super_secret_jwt_key_should_be_long_and_random_string_here
JWT_EXPIRE=7d

# Admin Initial Credentials (Dùng cho lần đầu seed admin)
ADMIN_EMAIL=admin@gmail.com
ADMIN_INITIAL_PASSWORD=change_this_admin_password_immediately

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Upload Config
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
